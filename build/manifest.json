{
  "schema_version": 1,
  "name": "nddev-claude-app",
  "build_version": "0.1.0",
  "entrypoint": "python3 cli-tools/nddev_claude.py",
  "source_root": "setups",
  "setup_ids": ["stable", "edge"],
  "managed_state": {
    "settings_file": "settings.json",
    "owned_keys": ["extraKnownMarketplaces.<marketplace-name>", "enabledPlugins.<plugin>@<marketplace>"],
    "stamp_file": "NDDEV-CLAUDE-SETUP.json",
    "stamp_schema": 1,
    "cli_owned_preserved": ["plugins/known_marketplaces.json", "plugins/marketplaces", "plugins/cache", "plugins/data"],
    "never_touched": [".credentials.json", "projects", "~/.claude.json"],
    "target_env": "CLAUDE_CONFIG_DIR"
  },
  "command_policy": {
    "json_supported": ["status", "plan", "apply", "switch", "restore", "remove"],
    "plan_mutates": false,
    "status_mutates": false,
    "executes_claude_binary": false,
    "software_lifecycle_managed": false,
    "target_required": ["status", "plan", "apply", "switch", "restore", "remove"],
    "restore_backup_option": "--backup <0..9>"
  },
  "backup_policy": {
    "canonical_target_bound": true,
    "location": "sibling .<target-name>.nddev-claude-backups",
    "pool_marker": "NDDEV-CLAUDE-BACKUPS.json",
    "slot_marker": "NDDEV-CLAUDE-BACKUP.json",
    "slots": 10
  },
  "transaction_policy": {
    "staging": "unique sibling .<target-name>.nddev-claude-txn-* directory",
    "lock": "exclusive sibling .<target-name>.nddev-claude-lock directory",
    "managed_file_mode": "0600",
    "new_target_mode": "0700",
    "target_parent_private_current_user": true,
    "target_private_current_user": true,
    "managed_files_no_follow": true,
    "managed_files_reject_hardlinks": true,
    "preserve_unmanaged_keys": true,
    "reject_symlink_managed_files": true,
    "reject_dangling_symlinks": true,
    "reject_non_private_or_non_owned_paths": true,
    "exact_rollback_bytes_modes_target_existence": true,
    "fresh_failure_cleanup": true,
    "rollback_on_failure": true,
    "atomic_rename": true
  },
  "plugin_marketplace": {
    "contract_ref": "config/nddev-contract.json:plugin_marketplace",
    "marketplace_id": "nddev-builder",
    "marketplace_manifest": ".claude-plugin/marketplace.json",
    "plugin_id": "nddev-builder",
    "plugin_manifest": "plugins/nddev-builder/.claude-plugin/plugin.json",
    "plugin_version_ref": "build/version.json:nddev_builder_plugin_version"
  },
  "runtime_compatibility": {
    "product": "Claude Code",
    "tested_version_ref": "build/version.json:claude_code_tested",
    "min_version_ref": "build/version.json:claude_code_min",
    "baseline_ref": "references/claude-baseline.json"
  }
}
