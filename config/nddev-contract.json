{
  "contract_version": 1,
  "product_name": "nddev-claude-app",
  "display_name": "NDDev Claude Code Setup Manager",
  "github_repository": "NDDev-it-com/nddev-claude-app",
  "license": "AGPL-3.0-or-later",
  "description": "Dependency-free manager that registers, updates, switches, and removes a selected NDDev Claude Code marketplace of plugins in a caller-selected Claude Code config directory, owning only managed settings and stamp files with atomic backups and rollback.",
  "manifest_ref": "build/manifest.json",
  "version_ref": "build/version.json",
  "source_root": "setups",
  "setup_system": {
    "catalog_root": "setups",
    "stamp_file": "NDDEV-CLAUDE-SETUP.json",
    "stamp_schema": 1,
    "identity_kind": "acquisition_channel",
    "immutable_setup_version": false,
    "ai_stp_immutable_path": "provider_protocol_v3",
    "commands": [
      "list",
      "status",
      "plan",
      "apply",
      "switch",
      "restore",
      "remove"
    ],
    "plan_mutates": false
  },
  "provider_protocol_v3": {
    "protocol_version": 3,
    "bundle_format": "ai-stp-bundle/1",
    "plan_format": "ai-stp-provider-plan/3",
    "state_format": "ai-stp-provider-state/3",
    "entrypoint": "cli-tools/nddev_claude.py",
    "core_commands": [
      "provider-info",
      "validate-bundle",
      "plan-operation",
      "apply-operation",
      "recover-operation",
      "status"
    ],
    "operations": ["backup", "install", "remove", "replace", "restore"],
    "optional_operations": {
      "launch": false,
      "software_install": false,
      "software_update": false,
      "software_remove": false
    },
    "state_file": "NDDEV-CLAUDE-PROVIDER.json",
    "state_schema": 3,
    "control_directory": ".nddev-claude-provider-backups",
    "lock_model": "canonical-target-directory-flock",
    "prepared_and_composed_share_bundle_path": true,
    "exact_plan_digest_required": true,
    "post_lock_target_revalidation": true
  },
  "plugin_marketplace": {
    "marketplace_id": "nddev-builder",
    "marketplace_manifest": ".claude-plugin/marketplace.json",
    "plugin_id": "nddev-builder",
    "plugin_manifest": "plugins/nddev-builder/.claude-plugin/plugin.json",
    "plugin_version_ref": "build/version.json:nddev_builder_plugin_version"
  },
  "managed_state": {
    "target_env": "CLAUDE_CONFIG_DIR",
    "backup_slots": 10,
    "managed_file_mode": "0600",
    "new_target_mode": "0700"
  },
  "safety": {
    "external_writes_require_approval": true,
    "preserve_unmanaged_files": true,
    "reject_symlink_managed_files": true,
    "rollback_on_failure": true
  },
  "runtime_compatibility": {
    "product": "Claude Code",
    "tested_version_ref": "build/version.json:claude_code_tested",
    "min_version_ref": "build/version.json:claude_code_min",
    "baseline_ref": "references/claude-baseline.json"
  }
}
