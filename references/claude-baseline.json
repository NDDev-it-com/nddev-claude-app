{
  "schema_version": 1,
  "product": "Claude Code",
  "verified_against": "Claude Code 2.1.226",
  "official_sources": [
    "https://code.claude.com/docs/en/setup",
    "https://code.claude.com/docs/en/env-vars",
    "https://code.claude.com/docs/en/settings",
    "https://code.claude.com/docs/en/plugin-marketplaces",
    "https://code.claude.com/docs/en/plugins-reference",
    "https://github.com/anthropics/claude-code/blob/main/.claude-plugin/marketplace.json"
  ],
  "config_dir": "~/.claude",
  "config_dir_env": "CLAUDE_CONFIG_DIR",
  "settings_file": "settings.json",
  "managed_settings_keys": [
    "extraKnownMarketplaces",
    "enabledPlugins"
  ],
  "cli_owned": [
    "plugins/known_marketplaces.json",
    "plugins/marketplaces",
    "plugins/cache",
    "plugins/data"
  ],
  "never_touch": [
    ".credentials.json",
    "projects",
    "~/.claude.json"
  ],
  "settings_surface": {
    "enabledPlugins": "plugin-name@marketplace-name boolean entries in settings.json",
    "extraKnownMarketplaces": "marketplace source entries in settings.json",
    "pluginConfigs": "Claude Code-owned plugin option values; not managed by this module",
    "strictKnownMarketplaces": "managed settings only; not authored by this module"
  },
  "native_plugin_surfaces": [
    "skills",
    "commands",
    "agents",
    "hooks",
    "mcpServers",
    "lspServers",
    "monitors",
    "themes",
    "userConfig",
    "channels",
    "dependencies",
    "defaultEnabled"
  ],
  "plugin_source_types": [
    {
      "type": "relative",
      "description": "./path within the marketplace repository"
    },
    {
      "type": "github",
      "description": "repo with optional ref and sha"
    },
    {
      "type": "url",
      "description": "git URL with optional ref and sha"
    },
    {
      "type": "git-subdir",
      "description": "git URL and path with optional ref and sha"
    },
    {
      "type": "npm",
      "description": "package with optional version and registry"
    },
    {
      "type": "archive",
      "description": "Claude Code 2.1.224+ HTTPS zip with optional sha256; unsupported by organization-managed plugin sync"
    }
  ],
  "plugin_manifest": ".claude-plugin/plugin.json",
  "marketplace_manifest": ".claude-plugin/marketplace.json",
  "plugin_manifest_required": [
    "name"
  ],
  "marketplace_manifest_required": [
    "name",
    "owner",
    "plugins"
  ]
}
